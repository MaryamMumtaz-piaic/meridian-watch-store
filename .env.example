# Database — local SQLite for development.
# To move to Neon/Postgres: set this to your Neon connection string and change
# the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-32-char-secret"
AUTH_TRUST_HOST="true"

# Google OAuth (optional — leave empty to hide the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — leave empty to use the mock checkout flow)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (optional — leave empty to log emails to the console instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="Maison Temps <orders@maisontemps.example>"

# Public site URL, used for absolute links in metadata and emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

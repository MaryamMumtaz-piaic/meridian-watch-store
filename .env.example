# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT  (copy to .env.local and fill in values)
# ─────────────────────────────────────────────────────────────────

# Database — SQLite for local dev
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js v5
AUTH_SECRET="replace-with-a-random-32-char-secret"
AUTH_TRUST_HOST="true"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — leave empty to use mock checkout)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (optional — leave empty to log emails to console)
RESEND_API_KEY=""
EMAIL_FROM="Maison Temps <orders@maisontemps.example>"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ─────────────────────────────────────────────────────────────────
# VERCEL PRODUCTION  — set these in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────
#
# 1. Create a FREE Neon PostgreSQL database at https://neon.tech
#    Copy the connection string (looks like: postgresql://user:pass@host/db?sslmode=require)
#
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
#
# 2. AUTH_SECRET — same value as local (generate with: openssl rand -base64 32)
# AUTH_SECRET=your-secret-here
#
# 3. AUTH_TRUST_HOST must be true on Vercel (no NEXTAUTH_URL needed)
# AUTH_TRUST_HOST=true
#
# 4. Set NEXT_PUBLIC_SITE_URL to your Vercel domain
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
#
# After setting env vars on Vercel, run a one-time migration:
#   DATABASE_URL=<neon-url> DATABASE_PROVIDER=postgresql npx prisma db push
#   DATABASE_URL=<neon-url> DATABASE_PROVIDER=postgresql npm run db:seed
# ─────────────────────────────────────────────────────────────────
